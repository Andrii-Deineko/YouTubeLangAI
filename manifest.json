{
  "manifest_version": 3,
  "name": "YouTube Lang AI",
  "version": "1.0.0",
  "description": "Learn foreign languages on YouTube with dual subtitles, Active Listening mode, contextual AI breakdown, FSRS flashcards, and Anki export.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/app/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "YouTube Lang AI"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/injected/interceptor.ts"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/index.ts"],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://translate.googleapis.com/*"
  ],
  "optional_host_permissions": ["http://127.0.0.1/*"]
}
